{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_ASK_URL": "https://pratik-proxy.dalliagac.workers.dev" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_ASK_URL": "https://pratik-proxy.dalliagac.workers.dev" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_ASK_URL": "https://pratik-proxy.dalliagac.workers.dev" }
    }
  },
  "submit": { "production": {} }
}
